.sudoku-board {
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  gap: 2rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #8795aa;
}

.sudoku-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  aspect-ratio: 1;
  color: #d7dfed;
  background: #1c2638;
  font-size: 30rpx;
}

.sudoku-cell:nth-child(3n) { margin-right: 4rpx; }
.sudoku-cell:nth-child(n+19):nth-child(-n+27),
.sudoku-cell:nth-child(n+46):nth-child(-n+54) { margin-bottom: 4rpx; }
.sudoku-cell.is-given { color: #f4f7fb; background: #26334a; font-weight: 800; }
.sudoku-cell.is-peer { background: #26334a; }
.sudoku-cell.is-selected { background: #4f6d91; }
.sudoku-cell.is-same { color: #8ee3c2; }
.sudoku-cell.is-error { color: #ff8d8d; }
.sudoku-cell.is-hint-target { box-shadow: inset 0 0 0 4rpx #f6d365; }
.sudoku-cell.is-hint-affected { background: #3a3445; }

.sudoku-notes {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  width: 100%;
  height: 100%;
  align-items: center;
  justify-items: center;
  color: #9eabc0;
  font-size: 16rpx;
}
