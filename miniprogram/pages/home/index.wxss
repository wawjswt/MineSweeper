.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx;
}

.empty-state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
}

.subtitle {
  color: #aab4c6;
  font-size: 28rpx;
}
