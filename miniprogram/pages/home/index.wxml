<view class="page-shell">
  <view wx:if="{{ready}}" class="arcade">
    <view class="header">
      <text class="title">Puzzle Arcade</text>
      <text class="subtitle">原生微信小程序运行切片</text>
    </view>

    <game-tabs tabs="{{games}}" bind:select="onSelectGame" />

    <view wx:if="{{activeGame === '2048' && game}}" class="game-card">
      <view class="score-row">
        <view><text class="score-label">SCORE</text><text class="score-value">{{game.score}}</text></view>
        <view><text class="score-label">BEST</text><text class="score-value">{{game.bestScore}}</text></view>
        <view><text class="score-label">STATUS</text><text class="score-value">{{game.status}}</text></view>
      </view>

      <view class="board-wrap" catchtouchstart="onTouchStart" catchtouchend="onTouchEnd">
        <view class="board-2048">
          <view
            wx:for="{{game.cells}}"
            wx:key="index"
            class="cell-2048 cell-2048-{{item.value}}"
          >{{item.value || ''}}</view>
        </view>
      </view>

      <view class="actions">
        <button class="primary-button" bindtap="onNewGame">新局</button>
        <button wx:if="{{game.status === 'won'}}" class="primary-button" bindtap="onContinue">继续</button>
      </view>

      <view class="direction-pad">
        <button class="direction-button direction-up" data-direction="up" bindtap="onTapMove">↑</button>
        <button class="direction-button" data-direction="left" bindtap="onTapMove">←</button>
        <button class="direction-button" data-direction="down" bindtap="onTapMove">↓</button>
        <button class="direction-button" data-direction="right" bindtap="onTapMove">→</button>
      </view>
      <text class="hint">滑动棋盘或点击方向按钮移动方块。</text>
    </view>

    <view wx:elif="{{activeGame === 'sweep' && game}}" class="game-card sweep-card">
      <view class="score-row">
        <view><text class="score-label">MINES</text><text class="score-value">{{game.mines}}</text></view>
        <view><text class="score-label">TIME</text><text class="score-value">{{game.timer}}</text></view>
        <view><text class="score-label">STATUS</text><text class="score-value">{{game.win ? '胜利' : (game.ended ? '结束' : '进行中')}}</text></view>
      </view>
      <minesweeper-board
        cells="{{game.cells}}"
        cols="{{game.cols}}"
        bind:reveal="onSweepReveal"
        bind:mark="onSweepMark"
      />
      <text wx:if="{{game.notice}}" class="notice">{{game.notice}}</text>
      <text wx:if="{{game.hint}}" class="notice">{{game.hint.message}}</text>
      <view class="actions">
        <button class="primary-button" bindtap="onNewGame">新局</button>
        <button class="secondary-button" bindtap="onSweepHint">提示</button>
      </view>
    </view>

    <view wx:elif="{{activeGame === 'sudoku' && game}}" class="game-card sudoku-card">
      <view class="score-row">
        <view><text class="score-label">TIME</text><text class="score-value">{{game.timer}}</text></view>
        <view><text class="score-label">LEFT</text><text class="score-value">{{game.remaining}}</text></view>
        <view><text class="score-label">ERRORS</text><text class="score-value">{{game.errors}}</text></view>
      </view>
      <sudoku-board cells="{{game.cells}}" bind:select="onSudokuSelect" />
      <text wx:if="{{game.notice}}" class="notice">{{game.notice}}</text>
      <view class="sudoku-pad">
        <button
          wx:for="{{sudokuDigits}}"
          wx:key="*this"
          class="digit-button {{item === game.activeDigit ? 'is-active' : ''}}"
          data-digit="{{item}}"
          bindtap="onSudokuInput"
        >{{item}}</button>
      </view>
      <view class="actions sudoku-actions">
        <button class="secondary-button" data-action="toggle-note" bindtap="onSudokuAction">{{game.noteMode ? '笔记：开' : '笔记：关'}}</button>
        <button class="secondary-button" data-action="erase" bindtap="onSudokuAction">擦除</button>
        <button class="secondary-button" data-action="hint" bindtap="onSudokuAction">提示</button>
      </view>
      <view class="actions sudoku-actions">
        <button class="secondary-button" data-action="undo" bindtap="onSudokuAction">撤销</button>
        <button class="secondary-button" data-action="redo" bindtap="onSudokuAction">重做</button>
        <button class="primary-button" bindtap="onNewGame">重置</button>
      </view>
    </view>

    <view wx:elif="{{activeGame === 'lianliankan' && game}}" class="game-card llk-card">
      <view class="score-row">
        <view><text class="score-label">TIME</text><text class="score-value">{{game.timer}}</text></view>
        <view><text class="score-label">LEFT</text><text class="score-value">{{game.remaining}}</text></view>
        <view><text class="score-label">SCORE</text><text class="score-value">{{game.score}}</text></view>
        <view><text class="score-label">COMBO</text><text class="score-value">×{{game.combo}}</text></view>
      </view>
      <lianliankan-board
        cells="{{game.cells}}"
        cols="{{game.cols}}"
        bind:select="onLianliankanSelect"
      />
      <text wx:if="{{game.notice}}" class="notice">{{game.notice}}</text>
      <view class="actions">
        <button class="primary-button" bindtap="onLianliankanNew">新局</button>
        <button class="secondary-button" bindtap="onLianliankanHint">提示</button>
        <button class="secondary-button" bindtap="onLianliankanReshuffle">重排</button>
      </view>
    </view>

    <view wx:elif="{{activeGame === 'rogue' && game}}" class="game-card rogue-card">
      <view class="score-row">
        <view><text class="score-label">STATUS</text><text class="score-value">{{game.status}}</text></view>
        <view><text class="score-label">LIFE</text><text class="score-value">{{game.lives}}</text></view>
        <view><text class="score-label">ENERGY</text><text class="score-value">{{game.energy}}</text></view>
      </view>
      <rogue-board
        cells="{{game.cells}}"
        cols="{{game.cols}}"
        bind:select="onRogueSelect"
        bind:mark="onRogueMark"
      />
      <rogue-hud
        game="{{game}}"
        bind:contract="onRogueContract"
        bind:tool="onRogueTool"
        bind:reward="onRogueReward"
      />
      <view class="actions">
        <button class="primary-button" bindtap="onRogueNew">新局</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state">
    <text class="title">正在加载</text>
  </view>
</view>
